
# ==========================================
# APACHE AIRFLOW - CONFIGURACION DE EJEMPLO
# ==========================================

# Usuario de Airflow en Docker
AIRFLOW_UID=50000

# Clave de cifrado de Airflow
# Reemplazar con una clave Fernet valida
FERNET_KEY=REEMPLAZAR_CON_CLAVE_FERNET_VALIDA


# ==========================================
# CONEXION A POSTGRESQL
# ==========================================

ICE_PG_HOST=host.docker.internal
ICE_PG_PORT=5433
ICE_PG_DB=ice_data
ICE_PG_USER=ice_user

# Debe coincidir con POSTGRES_PASSWORD
# del archivo .env principal
ICE_PG_PASSWORD=CAMBIAR_POR_CONTRASENA_POSTGRES
